{
  "name": "personal-control-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web && node scripts/prepare-pwa.mjs",
    "test:pwa": "node --test scripts/pwa.test.mjs",
    "test:dates": "node --test scripts/personal-dates.test.mjs",
    "test:photos": "node --test scripts/photo-framing.test.mjs",
    "test:storage": "node --test scripts/device-storage.test.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/david-libre": "0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "expo": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
